rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsJournal(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.enabled == true;
    }

    function validRecord(recordId) {
      let row = request.resource.data;
      let fields = ['group', 'key', 'rev', 'payload'];
      return recordId.matches('^[a-f0-9]{64}$')
        && row.keys().hasAll(fields) && row.keys().hasOnly(fields)
        && row.group in ['workouts', 'measurements', 'exercises', 'meta']
        && row.key is string
        && (row.group != 'meta' || row.key in ['measureTypes', 'lastBackup', 'oneRepMaxFormula'])
        && row.rev is string
        && row.rev.matches('^[0-9]{15}-[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$')
        && row.payload is string && row.payload.size() > 0;
    }

    match /users/{uid}/records/{recordId} {
      allow read: if ownsJournal(uid);
      // The client syncs an ordinary write with payload "null" when a record is deleted.
      allow create, update: if ownsJournal(uid) && validRecord(recordId);
    }
  }
}
